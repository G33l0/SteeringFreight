APP_NAME="Portlane Shipping"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Database. Two supported options; see README section 21.
#
# 1. SQLite. One file, no database server, nothing to configure. Suitable for a
#    freight desk creating up to a few hundred shipments a month with a handful
#    of staff signed in. Create the file with: touch database/database.sqlite
#    Give DB_DATABASE the absolute path, and leave the rest commented out.
#
# DB_CONNECTION=sqlite
# DB_DATABASE=/home/youraccount/portlane/database/database.sqlite
#
# 2. MySQL 8 or MariaDB 10.6+. Use this when several people write at once all
#    day, or your host backs up MySQL for you and not your files.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=portlane
DB_USERNAME=portlane
DB_PASSWORD=

# On SQLite, keep sessions and the cache off the database file so ordinary page
# views do not compete for its single write lock:
#   SESSION_DRIVER=file
#   CACHE_STORE=file
# Set to "*" only when the application runs behind a load balancer that
# terminates TLS for it (Render, Railway, Fly, Cloudflare in front of an
# origin). On shared hosting leave it empty: the request arrives at PHP
# directly, and a forwarded header would then be a lie anyone could tell.
TRUSTED_PROXIES=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Leave true in production so session cookies are only sent over HTTPS.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

# Mail. Most shared hosts provide SMTP details in the control panel, but a
# dedicated sending service keeps you off a shared IP's reputation. Brevo's free
# plan (300 emails a day, no card) is more than a freight desk needs:
#
#   MAIL_HOST=smtp-relay.brevo.com
#   MAIL_PORT=587
#   MAIL_USERNAME=your-brevo-login@example.com
#   MAIL_PASSWORD=the-smtp-key-from-brevo      # not your account password
#
# Authenticate your domain in Brevo first (SPF and DKIM), and use a from address
# on that domain. README section 19 has the walk through.
#
# Port 587 upgrades to TLS on its own. Only for the older port 465 add
# MAIL_SCHEME=smtps; MAIL_ENCRYPTION is not read by this framework version.
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Address that receives quote requests and contact form notifications.
MAIL_ADMIN_ADDRESS="operations@example.com"

# Brand colours. Both are also editable in the admin settings screen.
BRAND_PRIMARY_COLOUR="#0c1f2e"
BRAND_ACCENT_COLOUR="#ab4c17"

# Shipment tracking numbers. Both are also editable in the admin settings screen.
TRACKING_PREFIX=PLS
TRACKING_DIGITS=8

# Customer chat polling interval in milliseconds (shared hosting friendly).
CHAT_POLL_INTERVAL=8000

# How long a customer conversation is kept, in hours. It is deleted, with every
# message in it, this long after the last message. The chat never accepts files.
CHAT_RETENTION_HOURS=24

# Maximum upload size for shipment documents uploaded in the admin panel, in kilobytes.
UPLOAD_MAX_KB=8192

# How long a browser should refuse plain HTTP for this site, in seconds. Only
# sent over a connection that is already secure. A browser remembers it for the
# full duration whatever you do afterwards, so on a brand new deployment set
# HSTS_MAX_AGE=300 until the certificate is proven, then raise it to 31536000.
# Set to 0 to send nothing.
HSTS_MAX_AGE=31536000

VITE_APP_NAME="${APP_NAME}"
