APP_NAME="Portlane Shipping"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Database. Use "mysql" for MySQL 8 / MariaDB 10.6+ on shared hosting.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=portlane
DB_USERNAME=portlane
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Leave true in production so session cookies are only sent over HTTPS.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

# Mail. Most shared hosts provide SMTP details in the control panel.
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Address that receives quote requests and contact form notifications.
MAIL_ADMIN_ADDRESS="operations@example.com"

# Brand colours. Both are also editable in the admin settings screen.
BRAND_PRIMARY_COLOUR="#0c1f2e"
BRAND_ACCENT_COLOUR="#ab4c17"

# Shipment tracking numbers. Both are also editable in the admin settings screen.
TRACKING_PREFIX=PLS
TRACKING_DIGITS=8

# Customer chat polling interval in milliseconds (shared hosting friendly).
CHAT_POLL_INTERVAL=8000

# How long a customer conversation is kept, in hours. It is deleted, with every
# message in it, this long after the last message. The chat never accepts files.
CHAT_RETENTION_HOURS=24

# Maximum upload size for shipment documents uploaded in the admin panel, in kilobytes.
UPLOAD_MAX_KB=8192

VITE_APP_NAME="${APP_NAME}"
